---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "border-border bg-surface text-foreground inline-flex items-center gap-1 rounded-full border font-medium transition-colors",
      "hover:border-accent/40 hover:bg-accent/10 hover:text-accent",
      "focus-visible:text-accent",
      size === "sm" ? "px-3 py-1 text-xs sm:text-sm" : "px-3.5 py-1.5 text-sm",
    ]}
  >
    <IconHash class="size-3.5 opacity-65" />
    <span>{tagName}</span>
  </a>
</li>
