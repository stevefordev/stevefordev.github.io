---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-10 flex items-center justify-center gap-3 tabular-nums"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[
          "border-border bg-surface-elevated rounded-full border px-4 py-1.5 text-sm font-medium shadow-2xs transition-colors select-none",
          page.url.prev
            ? "hover:border-foreground/20 hover:bg-surface"
            : "pointer-events-none opacity-45",
        ]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block size-4 rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      <span class="text-muted-foreground px-2 text-sm font-medium">
        {page.currentPage} / {page.lastPage}
      </span>
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[
          "border-border bg-surface-elevated rounded-full border px-4 py-1.5 text-sm font-medium shadow-2xs transition-colors select-none",
          page.url.next
            ? "hover:border-foreground/20 hover:bg-surface"
            : "pointer-events-none opacity-45",
        ]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block size-4 rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
