---
import Layout from "./Layout.astro";
import config from "@/config";

type FaqItem = {
  question: string;
  answer: string;
};

type Props = {
  title?: string;
  rawTitle?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  faqs?: FaqItem[];
};

const { site } = config;

const {
  title,
  rawTitle,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags = [],
  faqs = [],
} = Astro.props;

const pageUrl = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const siteOrigin = site.url.replace(/\/+$/, "");
const articleHeadline = rawTitle ?? title ?? site.title;
const activeLocale = Astro.currentLocale ?? site.lang;

const authorEntity = {
  "@type": "Person",
  name: site.author,
  ...(site.profile && { url: site.profile }),
};

const blogPostingSchema = {
  "@type": "BlogPosting",
  "@id": `${pageUrl}#article`,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  headline: articleHeadline,
  ...(description && { description }),
  ...(ogImage && { image: ogImage }),
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...((modDatetime ?? pubDatetime) && {
    dateModified: (modDatetime ?? pubDatetime)!.toISOString(),
  }),
  ...(tags.length > 0 && { keywords: tags.join(", ") }),
  inLanguage: activeLocale,
  author: authorEntity,
  publisher: authorEntity,
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: site.title,
      item: `${siteOrigin}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Posts",
      item: `${siteOrigin}/posts/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: articleHeadline,
      item: pageUrl,
    },
  ],
};

const faqSchema =
  faqs.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${pageUrl}#faq`,
        mainEntity: faqs.map(item => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    blogPostingSchema,
    breadcrumbSchema,
    ...(faqSchema ? [faqSchema] : []),
  ],
};

// JSON.stringify leaves `<` alone, so a title containing `</script>` would
// end the ld+json block early. `\u003c` reads back as `<` for JSON parsers.
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c"
);
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </Fragment>

  <slot />
</Layout>
