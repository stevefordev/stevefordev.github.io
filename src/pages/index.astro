---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="border-border border-b pt-8 pb-8 sm:pt-12 sm:pb-10"
    >
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">
          {config.site.title}
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="border-border bg-surface text-muted-foreground hover:border-accent/40 hover:text-accent inline-flex size-8 items-center justify-center rounded-full border transition-colors"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={16} height={16} class="stroke-current stroke-2" />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p
        class="text-muted-foreground mt-4 max-w-2xl text-base leading-relaxed sm:text-lg"
      >
        개발 과정에서 마주친 문제와 학습 기록을 차분히 모아두는 공간입니다.{" "}
        <br class="hidden sm:inline" />
        계속 하려면, 계속 공부합니다.
      </p>
      <p class="text-muted-foreground mt-3 text-sm sm:text-base">
        전체 글 목록은{" "}
        <LinkButton
          class="text-accent font-medium underline-offset-4 hover:underline"
          href={getRelativeLocaleUrl(locale, "posts")}
        >
          포스트
        </LinkButton>
        에서 보거나,{" "}
        <LinkButton
          class="text-accent font-medium underline-offset-4 hover:underline"
          href={getRelativeLocaleUrl(locale, "search")}
        >
          검색
        </LinkButton>
        으로 바로 찾을 수 있습니다.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-5 flex max-sm:flex-col sm:items-center">
            <div class="text-muted-foreground me-2 mb-1 text-sm font-medium whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-8",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="mb-4 text-xl font-semibold tracking-tight sm:text-2xl">
            {t.home.featured}
          </h2>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" layout="featured" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-4">
          <h2 class="mb-3 text-xl font-semibold tracking-tight sm:text-2xl">
            {t.home.recentPosts}
          </h2>
          <ul class="space-y-1">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="border-border bg-surface-elevated text-foreground hover:border-foreground/20 hover:bg-surface inline-flex items-center gap-1.5 rounded-full border px-5 py-2.5 text-sm font-medium shadow-2xs transition-colors"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
