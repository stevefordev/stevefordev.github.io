---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="border-border bg-surface-elevated hover:border-foreground/18 hover:bg-surface group flex w-full items-center gap-3 rounded-2xl border p-4 shadow-2xs transition-colors"
      >
        <IconArrowLeft class="text-muted-foreground group-hover:text-accent inline-block size-5 flex-none transition-colors rtl:rotate-180" />
        <div class="min-w-0">
          <span class="text-muted-foreground text-xs font-medium">
            {t.post.previousPost}
          </span>
          <div class="text-foreground group-hover:text-accent mt-0.5 truncate text-sm font-semibold transition-colors">
            {prevPost.title}
          </div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="border-border bg-surface-elevated hover:border-foreground/18 hover:bg-surface group flex w-full items-center justify-end gap-3 rounded-2xl border p-4 text-end shadow-2xs transition-colors sm:col-start-2"
      >
        <div class="min-w-0">
          <span class="text-muted-foreground text-xs font-medium">
            {t.post.nextPost}
          </span>
          <div class="text-foreground group-hover:text-accent mt-0.5 truncate text-sm font-semibold transition-colors">
            {nextPost.title}
          </div>
        </div>
        <IconArrowRight class="text-muted-foreground group-hover:text-accent inline-block size-5 flex-none transition-colors rtl:rotate-180" />
      </a>
    )
  }
</div>
