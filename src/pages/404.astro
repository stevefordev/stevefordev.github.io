---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout my-1 flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center text-center">
      <h1 class="text-foreground text-8xl font-bold tracking-tight sm:text-9xl">
        404
      </h1>
      <p class="text-muted-foreground mt-4 text-xl sm:text-2xl">
        {t.notFound.message}
      </p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="bg-accent text-accent-foreground hover:text-accent-foreground mt-8 rounded-full px-6 py-2.5 text-sm font-medium shadow-2xs transition-opacity hover:opacity-90"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
